# ===============================================
# EN NANBA Clinical Intelligence Platform POC
# Environment Configuration
# ===============================================

# Server Port
PORT=4000
NODE_ENV=development

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nanba_admin
POSTGRES_PASSWORD=nanba_secure_pass123
POSTGRES_DB=en_nanban_clinical

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nanba_graph_pass123

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Fallback & Mock Simulation
# Set to 'true' to use in-memory/simulated databases if Docker services are not running
ENABLE_IN_MEMORY_FALLBACK=true
