<style>
  body { font-family: "Calibri", "Segoe UI", Arial, sans-serif; font-size: 11pt; line-height: 1.6; color: #1e293b; margin: 40pt; }
  h1 { font-size: 26pt; color: #0284c7; font-weight: bold; border-bottom: 3pt solid #0284c7; padding-bottom: 8pt; margin-bottom: 6pt; }
  .subtitle { font-size: 13pt; color: #64748b; font-weight: 500; margin-bottom: 24pt; }
  h2 { font-size: 16pt; color: #0f766e; font-weight: bold; margin-top: 24pt; border-bottom: 1pt solid #cbd5e1; padding-bottom: 4pt; }
  h3 { font-size: 13pt; color: #334155; font-weight: bold; margin-top: 14pt; }
  table { border-collapse: collapse; width: 100%; margin: 12pt 0; font-size: 10pt; }
  th { background-color: #0284c7; color: #ffffff; font-weight: bold; padding: 8pt 10pt; border: 1pt solid #cbd5e1; text-align: left; }
  td { padding: 8pt 10pt; border: 1pt solid #cbd5e1; vertical-align: top; }
  tr:nth-child(even) { background-color: #f8fafc; }
  .box { background-color: #f1f5f9; border-left: 4pt solid #0284c7; padding: 12pt; margin: 12pt 0; border-radius: 4pt; }
  .step-card { background-color: #f8fafc; border: 1pt solid #cbd5e1; border-left: 6pt solid #0f766e; padding: 12pt 16pt; margin: 12pt 0; }
  .alert-box { background-color: #fef2f2; border-left: 5pt solid #ef4444; padding: 12pt; margin: 12pt 0; color: #991b1b; }
  .success-box { background-color: #f0fdf4; border-left: 5pt solid #10b981; padding: 12pt; margin: 12pt 0; color: #065f46; }
  .code { font-family: "Consolas", monospace; background-color: #f1f5f9; padding: 2pt 4pt; font-size: 9.5pt; color: #0369a1; border-radius: 3pt; }
  .badge { display: inline-block; padding: 3pt 8pt; border-radius: 10pt; font-size: 8.5pt; font-weight: bold; text-transform: uppercase; }
  .badge-blue { background-color: #e0f2fe; color: #0369a1; }
  .badge-red { background-color: #fee2e2; color: #991b1b; }
  .badge-green { background-color: #dcfce7; color: #166534; }
  .badge-purple { background-color: #f3e8ff; color: #6b21a8; }
  .footer { margin-top: 40pt; font-size: 9pt; color: #94a3b8; border-top: 1pt solid #e2e8f0; padding-top: 10pt; text-align: center; }
</style>
